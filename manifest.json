{
  "manifest_version": 3,
  "name": "EchoLink AI - Smart Engagement Assistant",
  "short_name": "EchoLink",
  "version": "2.0",
  "description": "Assistant IA contextuel pour LinkedIn propulsé par Gemini",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}